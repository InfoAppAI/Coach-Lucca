# Variáveis do servidor (funções em api/). Configure no painel da Vercel:
# Project → Settings → Environment Variables (Production e Preview).
# NUNCA coloque os valores reais neste arquivo nem em nenhum arquivo do repositório.

# Hotmart → Ferramentas → Credenciais Hotmart (API)
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=
# "sandbox" para testar com credenciais de sandbox; vazio = produção
HOTMART_ENV=

# IDs dos produtos na Hotmart (Produtos → seu produto → ID)
HOTMART_PRODUCT_ID=
HOTMART_UPSELL_PRODUCT_ID=

# Chave para assinar o cookie de sessão (64+ caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Público (vai para o navegador): link do checkout do Acelerador para quem
# quiser comprar depois, de dentro do app. Vazio = botão escondido.
VITE_UPSELL_CHECKOUT_URL=
